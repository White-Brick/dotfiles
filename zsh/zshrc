#

# Set what highlighters will be used.
# See https://github.com/zsh-users/zsh-syntax-highlighting/blob/master/docs/highlighters.md
ZSH_HIGHLIGHT_HIGHLIGHTERS=(main brackets)

# Customize the main highlighter styles.
# See https://github.com/zsh-users/zsh-syntax-highlighting/blob/master/docs/highlighters/main.md#how-to-tweak-it
#typeset -A ZSH_HIGHLIGHT_STYLES
#ZSH_HIGHLIGHT_STYLES[comment]='fg=242'

# yazi
function yz() {
	local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
	command yazi "$@" --cwd-file="$tmp"
	IFS= read -r -d '' cwd < "$tmp"
	[ "$cwd" != "$PWD" ] && [ -d "$cwd" ] && builtin cd -- "$cwd"
	rm -f -- "$tmp"
}

# ------------------
# Initialize modules
# ------------------

ZIM_HOME=${ZIM_HOME:-${ZDOTDIR:-${HOME}}/.zim}
if [[ ! -d ${ZIM_HOME} ]]; then
  ZIM_HOME=${XDG_CONFIG_HOME:-${HOME}/.config}/zim
fi

ZIM_CONFIG_FILE=${ZIM_CONFIG_FILE:-${ZDOTDIR:-${HOME}}/.zimrc}
if [[ ! -r ${ZIM_CONFIG_FILE} ]]; then
  ZIM_CONFIG_FILE=${XDG_CONFIG_HOME:-${HOME}/.config}/zim/zimrc
fi

if (( ! __BIC_ZSH_FIRST_LOAD )); then
  # Keep init.zsh in sync locally. Initial install/bootstrap stays manual.
  if [[ -r ${ZIM_HOME}/zimfw.zsh && -r ${ZIM_CONFIG_FILE} && ( ! -r ${ZIM_HOME}/init.zsh || ! ${ZIM_HOME}/init.zsh -nt ${ZIM_CONFIG_FILE} ) ]]; then
    source ${ZIM_HOME}/zimfw.zsh init
  fi

  # Initialize Zim modules during the first shell startup only.
  if [[ -r ${ZIM_HOME}/init.zsh ]]; then
    source ${ZIM_HOME}/init.zsh
  fi
fi
# }}} End configuration added by Zim Framework install

# 禁用跨 pane 历史共享（zim environment 模块会启用 SHARE_HISTORY）
unsetopt SHARE_HISTORY

# fzf-tab: zim completion 默认用 %F{yellow}，会原样显示在 fzf 里
# https://github.com/Aloxaf/fzf-tab#configure
zstyle ':completion:*:descriptions' format '[%d]'
zstyle ':completion:*' menu no
zstyle ':fzf-tab:*' switch-group '<' '>'
# 空命令行 Tab 不补全全部 PATH 命令（避免 1000+ 候选）
zstyle ':completion:*' insert-tab true

# Source custom configurations
[[ -r ~/.config/zsh/aliases.zsh ]] && source ~/.config/zsh/aliases.zsh
[[ -r ~/.config/zsh/aliases.local.zsh ]] && source ~/.config/zsh/aliases.local.zsh
[[ -r ~/.config/zsh/vi.zsh ]] && source ~/.config/zsh/vi.zsh

# Environment
typeset -U path PATH
if [[ -x /opt/homebrew/bin/brew ]]; then
  eval "$(/opt/homebrew/bin/brew shellenv)"
fi
path=(
  "$HOME/.local/bin"
  "$HOME/.antigravity/antigravity/bin"
  "$HOME/.opencode/bin"
  $path
)

export EDITOR=nvim

# Bind Ctrl-o to clear the terminal screen.
bindkey '^O' clear-screen

(( ! ${+functions[p10k]} )) || p10k finalize
typeset -gi __BIC_ZSH_INIT_DONE=1

# Homebrew 中科大镜像源
export HOMEBREW_BREW_GIT_REMOTE="https://mirrors.ustc.edu.cn/brew.git"
export HOMEBREW_CORE_GIT_REMOTE="https://mirrors.ustc.edu.cn/homebrew-core.git"
export HOMEBREW_BOTTLE_DOMAIN="https://mirrors.ustc.edu.cn/homebrew-bottles"
export HOMEBREW_API_DOMAIN="https://mirrors.ustc.edu.cn/homebrew-bottles/api"
# 绕过代理访问国内镜像源
export NO_PROXY="mirrors.ustc.edu.cn,127.0.0.1,localhost"
export no_proxy="mirrors.ustc.edu.cn,127.0.0.1,localhost"

# fzf 快捷键绑定 + 补全（completion.zsh 启用 cd **<Tab>，并让 zi 的交互列表正常工作）
source /opt/homebrew/opt/fzf/shell/key-bindings.zsh
source /opt/homebrew/opt/fzf/shell/completion.zsh

# To customize prompt, run `p10k configure` or edit p10k config file.
# Try XDG path first, fallback to traditional path
if [[ -f ~/.config/zsh/p10k.zsh ]]; then
  source ~/.config/zsh/p10k.zsh
elif [[ -f ~/.p10k.zsh ]]; then
  source ~/.p10k.zsh
fi

# OpenTUI cannot auto-detect Kitty behind tmux; force Kitty's OSC 99 notifications.
if [[ -n "${KITTY_WINDOW_ID:-}" ]]; then
  export OPENTUI_NOTIFICATION_PROTOCOL=osc99
fi

# tmux: 在目录变化时通知 tmux 更新 pane_current_path
if [[ -n "$TMUX" ]]; then
  function _tmux_update_pane_path() {
    emulate -L zsh
    [[ "$PWD" != "$_tmux_last_pwd" ]] || return
    _tmux_last_pwd="$PWD"
    tmux set-option -p pane-current-path "$PWD" 2>/dev/null
  }
  autoload -Uz add-zsh-hook
  add-zsh-hook chpwd _tmux_update_pane_path
fi

# zoxide: 智能目录跳转（保留原生 cd，用 z 跳转、zi 交互选择）
# 必须放在 zshrc 最末尾：在所有 chpwd / prompt hook（p10k、tmux 等）注册之后初始化
eval "$(zoxide init zsh --cmd cd)"
