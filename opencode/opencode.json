{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {},
  "model": "glm-xy/glm-5.2",
  "small_model": "kimi-for-coding/k2p7",
  "plugin": [],
  "provider": {
    "glm-xy": {
      "name": "glm-xy",
      "api": "anthropic",
      "options": {
        "baseURL": "https://biancheng.99code.me/v1"
      },
      "models": {
        "glm-4.6": {
          "name": "GLM 4.6",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "glm-4.7": {
          "name": "GLM 4.7",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "glm-5": {
          "name": "GLM 5",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "glm-5.1": {
          "name": "GLM 5.1",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 128000,
            "output": 8192
          }
        },
        "glm-5.2": {
          "name": "GLM 5.2",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 128000,
            "output": 8192
          }
        }
      }
    }
  },
  "agent": {
    "build": {
      "model": "kimi-for-coding/k2p7"
    },
    "planner": {
      "model": "openai/gpt-5.6-sol"
    },
    "architect": {
      "model": "kimi-for-coding/k2p7"
    },
    "code-reviewer": {
      "model": "openai/gpt-5.6-sol"
    },
    "security-reviewer": {
      "model": "kimi-for-coding/k2p7"
    },
    "tdd-guide": {
      "model": "kimi-for-coding/k2p7"
    },
    "build-error-resolver": {
      "model": "openai/gpt-5.6-sol"
    },
    "e2e-runner": {
      "model": "kimi-for-coding/k2p7"
    },
    "doc-updater": {
      "model": "kimi-for-coding/k2p7"
    },
    "refactor-cleaner": {
      "model": "openai/gpt-5.6-sol"
    },
    "database-reviewer": {
      "model": "kimi-for-coding/k2p7"
    },
    "docs-lookup": {
      "model": "kimi-for-coding/k2p7"
    },
    "harness-optimizer": {
      "model": "kimi-for-coding/k2p7"
    },
    "loop-operator": {
      "model": "kimi-for-coding/k2p7"
    },
    "python-reviewer": {
      "model": "kimi-for-coding/k2p7"
    }
  }
}
