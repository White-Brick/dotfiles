{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "agents": {
    "atlas": {
      "model": "zhipuai-coding-plan/glm-5-turbo"
    },
    "explore": {
      "model": "zhipuai-coding-plan/glm-5-turbo"
    },
    "hephaestus": {
      "model": "openai/gpt-5.5",
      "variant": "xhigh"
    },
    "librarian": {
      "model": "kimi-for-coding/k2p5"
    },
    "metis": {
      "model": "openai/gpt-5.5",
      "variant": "xhigh"
    },
    "momus": {
      "model": "openai/gpt-5.5",
      "variant": "xhigh"
    },
    "multimodal-looker": {
      "model": "openai/gpt-5.5",
      "variant": "medium"
    },
    "oracle": {
      "model": "openai/gpt-5.5",
      "variant": "xhigh"
    },
    "prometheus": {
      "model": "openai/gpt-5.5",
      "variant": "xhigh"
    },
    "sisyphus": {
      "model": "openai/gpt-5.5",
      "variant": "xhigh"
    },
    "sisyphus-junior": {
      "model": "openai/gpt-5.4",
      "variant": "xhigh"
    }
  },
  "categories": {
    "artistry": {
      "model": "openai/gpt-5.5",
      "variant": "xhigh"
    },
    "deep": {
      "model": "openai/gpt-5.5",
      "variant": "xhigh"
    },
    "quick": {
      "model": "zhipuai-coding-plan/glm-5-turbo"
    },
    "ultrabrain": {
      "model": "openai/gpt-5.5",
      "variant": "xhigh"
    },
    "unspecified-high": {
      "model": "openai/gpt-5.5",
      "variant": "xhigh"
    },
    "unspecified-low": {
      "model": "zhipuai-coding-plan/glm-5-turbo"
    },
    "visual-engineering": {
      "model": "kimi-for-coding/k2p5"
    },
    "writing": {
      "model": "zhipuai-coding-plan/glm-5-turbo"
    }
  },
  "background_task": {
    "providerConcurrency": {
      "anthropic": 3,
      "openai": 3,
      "zhipuai-coding-plan": 10,
      "kimi-for-coding": 10
    }
  },
  "experimental": {
    "aggressive_truncation": true,
    "task_system": true
  },
  "claude_code": {
    "agents": false,
    "commands": false,
    "hooks": false,
    "mcp": false,
    "plugins": false,
    "skills": false
  }
}
